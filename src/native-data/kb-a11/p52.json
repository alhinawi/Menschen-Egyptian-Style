    {
      "x": 556,
      "y": 879,
      "w": 490,
      "text": "über Essen/Essgewohnheiten sprechen",
      "size": 18,
      "bold": true,
      "serif": true
    },
    {
      "x": 556,
      "y": 910,
      "w": 226,
      "text": "Was isst du gern zum Früh-\n  stück?",
      "size": 18,
      "bold": false,
      "serif": true
    },
    {
      "x": 799,
      "y": 910,
      "w": 250,
      "text": "Ich esse gern Käsebrötchen/...\n  zum Frühstück. Und du?\n\nIch mag keinen Käse/..., aber\n  Müsli/... esse ich gern.",
      "size": 17,
      "bold": false,
      "serif": true
    },
    {
      "x": 556,
      "y": 1020,
      "w": 226,
      "text": "Wann frühstückst du?",
      "size": 18,
      "bold": false,
      "serif": true
    },
    {
      "x": 799,
      "y": 1020,
      "w": 246,
      "text": "In der Woche frühstücke ich\n  schon um sechs Uhr. Am Wo-\n  chenende/Sonntag frühstücke\n  ich oft erst um elf Uhr.",
      "size": 17,
      "bold": false,
      "serif": true
    },
    {
      "x": 556,
      "y": 1116,
      "w": 226,
      "text": "Was essen wir als Vorspeise/\n  Hauptgericht/Dessert?",
      "size": 17,
      "bold": false,
      "serif": true
    },
    {
      "x": 799,
      "y": 1116,
      "w": 250,
      "text": "Als Vorspeise essen wir Suppe.",
      "size": 17,
      "bold": false,
      "serif": true
    },
    {
      "x": 556,
      "y": 1184,
      "w": 490,
      "text": "beim Essen",
      "size": 18,
      "bold": true,
      "serif": true
    },
    {
      "x": 556,
      "y": 1216,
      "w": 280,
      "text": "Möchten Sie einen Kaffee/...?",
      "size": 17,
      "bold": false,
      "serif": true
    },
    {
      "x": 852,
      "y": 1216,
      "w": 195,
      "text": "Oh ja! Bitte. / Ja, gern.",
      "size": 16,
      "bold": false,
      "serif": true
    },
    {
      "x": 556,
      "y": 1250,
      "w": 280,
      "text": "Möchten Sie noch etwas Suppe/...?",
      "size": 16,
      "bold": false,
      "serif": true
    },
    {
      "x": 852,
      "y": 1250,
      "w": 195,
      "text": "Nein, danke!",
      "size": 17,
      "bold": false,
      "serif": true
    },
    {
      "x": 556,
      "y": 1283,
      "w": 280,
      "text": "Guten Appetit!",
      "size": 18,
      "bold": false,
      "serif": true
    },
    {
      "x": 852,
      "y": 1283,
      "w": 194,
      "text": "Danke, ebenfalls/gleich-\n  falls.\n... schmeckt sehr gut.",
      "size": 16,
      "bold": false,
      "serif": true
    },
