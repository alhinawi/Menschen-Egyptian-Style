      "text": "du das noch\neinmal",
      "size": 17,
      "bold": false,
      "serif": true
    },
    {
      "x": 435,
      "y": 1258,
      "w": 95,
      "text": "sagen?",
      "size": 17,
      "bold": false,
      "serif": true
    },
    {
      "x": 560,
      "y": 890,
      "w": 475,
      "text": "Komplimente machen und sich bedanken",
      "size": 18,
      "bold": true,
      "serif": true
    },
    {
      "x": 560,
      "y": 924,
      "w": 475,
      "text": "Sie können ja/wirklich/aber/toll/super/sehr gut tanzen ...",
      "size": 16,
      "bold": false,
      "serif": true
    },
    {
      "x": 560,
      "y": 955,
      "w": 475,
      "text": "Vielen Dank! / Oh, danke! / Danke sehr! / Herzlichen Dank.",
      "size": 16,
      "bold": false,
      "serif": true
    },
    {
      "x": 560,
      "y": 999,
      "w": 475,
      "text": "Fähigkeiten",
      "size": 18,
      "bold": true,
      "serif": true
    },
    {
      "x": 560,
      "y": 1031,
      "w": 475,
      "text": "Ich kann (gar) nicht / nicht so gut / ein bisschen / (sehr)\n  gut singen/...",
      "size": 17,
      "bold": false,
      "serif": true
    },
    {
      "x": 560,
      "y": 1097,
      "w": 475,
      "text": "über Hobbys sprechen",
      "size": 18,
      "bold": true,
      "serif": true
    },
    {
      "x": 560,
      "y": 1130,
      "w": 157,
      "text": "Was sind deine\n  Hobbys?",
      "size": 17,
      "bold": false,
      "serif": true
    },
    {
      "x": 715,
      "y": 1130,
      "w": 321,
      "text": "Meine Hobbys sind ... und ...\nMein Hobby ist ...",
      "size": 16,
      "bold": false,
      "serif": true
    },
    {
      "x": 560,
      "y": 1180,
      "w": 157,
      "text": "Was machst du in\n  der Freizeit?",
      "size": 17,
      "bold": false,
      "serif": true
    },
    {
      "x": 715,
      "y": 1180,
      "w": 321,
      "text": "Ich ... gern. Das macht Spaß.\nIch liebe ...",
      "size": 16,
      "bold": false,
      "serif": true
    },
    {
      "x": 560,
      "y": 1235,
      "w": 157,
      "text": "Fährst du gern\n  Ski/Rad/...?",
      "size": 17,
      "bold": false,
      "serif": true
    },
    {
      "x": 715,
      "y": 1235,
      "w": 321,
      "text": "Nein, ich kann nicht Ski/Rad/... fahren.\nNein, ich fahre nicht gern Ski/Rad/...\nIch lese gern und treffe Freunde.",
      "size": 16,
      "bold": false,
      "serif": true
    },
    {
      "x": 560,
      "y": 1310,
      "w": 157,
      "text": "Wie oft gehst du\n  ins Kino ...?",
      "size": 17,
      "bold": false,
      "serif": true
    },
    {
      "x": 715,
      "y": 1310,
      "w": 321,
      "text": "Ich gehe oft/manchmal/nie ins Kino.\nMein Lieblingsfilm/Lieblings-... ist ...",
      "size": 16,
      "bold": false,
      "serif": true
    },
    {
      "x": 560,
      "y": 1381,
      "w": 475,
      "text": "um etwas bitten",
      "size": 18,
      "bold": true,
      "serif": true
    },
