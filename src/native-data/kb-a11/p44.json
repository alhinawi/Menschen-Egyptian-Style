  "textBlocks": [
    {
      "x": 126,
      "y": 181,
      "w": 850,
      "text": "SPRECHTRAINING",
      "size": 31,
      "bold": false,
      "serif": true,
      "color": "#a99e72"
    },
    {
      "x": 178,
      "y": 228,
      "w": 430,
      "text": "Um etwas bitten",
      "size": 21,
      "bold": true,
      "serif": false
    },
    {
      "x": 139,
      "y": 265,
      "w": 480,
      "text": "a   Arbeiten Sie zu zweit. Würfeln Sie eine Antwort.\n    Fragen und antworten Sie dann.",
      "size": 18,
      "bold": true,
      "serif": false
    },
    {
      "x": 169,
      "y": 327,
      "w": 310,
      "text": "1  ■ Kann ich mal telefonieren?",
      "size": 18,
      "bold": false,
      "serif": true
    },
    {
      "x": 169,
      "y": 365,
      "w": 310,
      "text": "2  ■ Kann ich hier rauchen?",
      "size": 18,
      "bold": false,
      "serif": true
    },
    {
      "x": 169,
      "y": 403,
      "w": 310,
      "text": "3  ■ Kann ich das Auto haben?",
      "size": 18,
      "bold": false,
      "serif": true
    },
    {
      "x": 650,
      "y": 261,
      "w": 380,
      "text": "b   Warum können Sie noch bitten?\n    Schreiben Sie vier Fragen auf Karten.",
      "size": 18,
      "bold": true,
      "serif": false
    },
    {
      "x": 723,
      "y": 337,
      "w": 168,
      "text": "Kann ich das\nFeuerzeug haben?",
      "size": 16,
      "bold": false,
      "serif": false,
      "color": "#3154a7"
    },
    {
      "x": 670,
      "y": 420,
      "w": 185,
      "text": "Legen Sie die Karten\nauf einen Stapel.",
      "size": 19,
      "bold": false,
      "serif": true
    },
    {
      "x": 650,
      "y": 479,
      "w": 390,
      "text": "c   Spielen Sie zu viert. Ziehen Sie Karten.\n    Fragen und antworten Sie dann.",
      "size": 18,
      "bold": true,
      "serif": false
    },
    {
      "x": 212,
      "y": 475,
      "w": 310,
      "text": "Ja, klar. / Ja, natürlich. /\n   Ja, gern.",
      "size": 19,
      "bold": false,
      "serif": true
    },
    {
      "x": 212,
      "y": 575,
      "w": 310,
      "text": "Nicht so gern.",
      "size": 19,
      "bold": false,
      "serif": true
    },
    {
      "x": 212,
      "y": 657,
      "w": 310,
      "text": "Nein, das geht leider nicht. /\n   Nein, tut mir leid.",
      "size": 19,
      "bold": false,
      "serif": true
    },
    {
      "x": 133,
      "y": 853,
      "w": 410,
      "text": "GRAMMATIK",
      "size": 31,
      "bold": false,
      "serif": true,
      "color": "#a99e72"
    },
    {
      "x": 552,
      "y": 853,
