      "size": 23,
      "bold": true,
      "serif": false
    },
    {
      "text": "Betreff: Heute\n\nTimo!\nKomme doch nicht.\nKeine Zeit!\nSina",
      "x": 618,
      "y": 209,
      "w": 328,
      "size": 17,
      "bold": false,
      "serif": false
